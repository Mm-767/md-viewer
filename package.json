{
  "name": "md-viewer",
  "productName": "MD Viewer",
  "version": "0.1.0",
  "description": "마크다운 뷰어/에디터",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild renderer.mjs --bundle --format=iife --minify --outfile=dist/renderer.js && mkdir -p dist/katex && cp -R node_modules/katex/dist/katex.min.css node_modules/katex/dist/fonts dist/katex/ && cp node_modules/github-markdown-css/github-markdown.css dist/",
    "start": "npm run build && electron .",
    "test": "node test.mjs",
    "dist": "npm run build && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "github-markdown-css": "^5.9.0",
    "katex": "^0.16.47",
    "mermaid": "^12.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "build": {
    "appId": "io.github.mm767.mdviewer",
    "productName": "MD Viewer",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "dist/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "role": "Editor",
        "rank": "Default"
      }
    ]
  }
}
